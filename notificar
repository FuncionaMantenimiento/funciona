// Archivo: worker.js (Cloudflare Worker)

// Configuración de CORS para permitir solicitudes desde tu sitio
const corsHeaders = {
  "Access-Control-Allow-Origin": "*", // En producción, cambia esto a tu dominio
  "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
  "Access-Control-Allow-Headers": "Content-Type"
};

// Maneja las solicitudes OPTIONS (pre-flight)
function handleOptions(request) {
  return new Response(null, {
    headers: corsHeaders
  });
}

// Base de datos KV para almacenar suscripciones
// Debes crear este namespace en Cloudflare Workers KV
// SUBSCRIPTIONS es el nombre del namespace

async function saveSubscription(subscription) {
  const endpoint = subscription.endpoint;
  await SUBSCRIPTIONS.put(endpoint, JSON.stringify(subscription));
  return new Response(JSON.stringify({ success: true }), {
    headers: {
      "Content-Type": "application/json",
      ...corsHeaders
    }
  });
}

async function deleteSubscription(endpoint) {
  await SUBSCRIPTIONS.delete(endpoint);
  return new Response(JSON.stringify({ success: true }), {
    headers: {
      "Content-Type": "application/json",
      ...corsHeaders
    }
  });
}

async function sendNotification(request) {
  const { title, body, icon, url, secretKey } = await request.json();
  
  // Verificar clave secreta (debes configurar esto en tus variables de entorno)
  if (secretKey !== ADMIN_SECRET) {
    return new Response(JSON.stringify({ error: "No autorizado" }), {
      status: 401,
      headers: {
        "Content-Type": "application/json",
        ...corsHeaders
      }
    });
  }
  
  // Obtener todas las suscripciones
  const subscriptionList = await SUBSCRIPTIONS.list();
  const keys = subscriptionList.keys;
  
  if (!keys || keys.length === 0) {
    return new Response(JSON.stringify({ message: "No hay suscriptores" }), {
      headers: {
        "Content-Type": "application/json",
        ...corsHeaders
      }
    });
  }
  
  // Importar la biblioteca web-push
  const webpush = await import('web-push');
  
  // Configurar web-push con tus claves VAPID
  webpush.setVapidDetails(
    `mailto:${CONTACT_EMAIL}`,
    VAPID_PUBLIC_KEY,
    VAPID_PRIVATE_KEY
  );
  
  // Preparar la notificación
  const notification = {
    title,
    body,
    icon: icon || 'https://tu-sitio.com/icon.png',
    url: url || 'https://tu-sitio.com'
  };
  
  // Enviar notificaciones a todos los suscriptores
  let succeeded = 0;
  let failed = 0;
  
  for (const key of keys) {
    try {
      const subscriptionData = await SUBSCRIPTIONS.get(key.name, { type: "json" });
      
      if (subscriptionData) {
        await webpush.sendNotification(
          subscriptionData,
          JSON.stringify(notification)
        );
        succeeded++;
      }
    } catch (error) {
      // Si la suscripción ya no es válida, eliminarla
      if (error.statusCode === 404 || error.statusCode === 410) {
        await SUBSCRIPTIONS.delete(key.name);
      }
      failed++;
    }
  }
  
  return new Response(JSON.stringify({
    success: true,
    message: `Notificación enviada a ${succeeded} suscriptores. Fallaron: ${failed}`
  }), {
    headers: {
      "Content-Type": "application/json",
      ...corsHeaders
    }
  });
}

// Función principal que maneja todas las solicitudes
async function handleRequest(request) {
  // Manejar solicitudes OPTIONS (CORS)
  if (request.method === "OPTIONS") {
    return handleOptions(request);
  }
  
  const url = new URL(request.url);
  const path = url.pathname;
  
  // Rutas de la API
  if (path === "/api/save-subscription" && request.method === "POST") {
    const subscription = await request.json();
    return saveSubscription(subscription);
  }
  
  if (path === "/api/delete-subscription" && request.method === "POST") {
    const { endpoint } = await request.json();
    return deleteSubscription(endpoint);
  }
  
  if (path === "/api/send-notification" && request.method === "POST") {
    return sendNotification(request);
  }
  
  if (path === "/api/get-vapid-key" && request.method === "GET") {
    return new Response(JSON.stringify({
      publicKey: VAPID_PUBLIC_KEY
    }), {
      headers: {
        "Content-Type": "application/json",
        ...corsHeaders
      }
    });
  }
  
  // Página principal - código HTML para suscribirse a notificaciones
  if (path === "/" || path === "") {
    return new Response(HTML_CONTENT, {
      headers: {
        "Content-Type": "text/html",
        ...corsHeaders
      }
    });
  }
  
  // Página de administración
  if (path === "/admin") {
    return new Response(ADMIN_HTML_CONTENT, {
      headers: {
        "Content-Type": "text/html",
        ...corsHeaders
      }
    });
  }
  
  // Service Worker
  if (path === "/sw.js") {
    return new Response(SERVICE_WORKER_CONTENT, {
      headers: {
        "Content-Type": "application/javascript",
        ...corsHeaders
      }
    });
  }
  
  // Ruta no encontrada
  return new Response("Not Found", { status: 404 });
}

// Escuchar eventos fetch
addEventListener("fetch", event => {
  event.respondWith(handleRequest(event.request));
});

